# ============================================================
# LLM 凭据与端点
# ------------------------------------------------------------
# 两种任选其一：
#   (a) 官方 Anthropic：ANTHROPIC_API_KEY=sk-ant-...
#   (b) Anthropic 兼容端点：ANTHROPIC_BASE_URL + ANTHROPIC_AUTH_TOKEN
#       （本机当前用的是 MiniMax 的兼容端点，见 .env）
#
# ⚠️ .env 含明文凭据，已被 .gitignore 忽略，**不要提交**
# ============================================================

ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_API_KEY=

# 模型 ID（与 Claude Code 全局配置保持一致）
# ⚠️ 走第三方端点时不能写 claude-opus-5-5 —— 端点不提供该模型，会 404
ANTHROPIC_MODEL=MiniMax-M3.1-Flash
ANTHROPIC_DEFAULT_OPUS_MODEL=MiniMax-M3.1-Flash
ANTHROPIC_DEFAULT_SONNET_MODEL=MiniMax-M3.1-Flash
ANTHROPIC_DEFAULT_HAIKU_MODEL=MiniMax-M3.1-Flash
ANTHROPIC_SMALL_FAST_MODEL=MiniMax-M3.1-Flash

API_TIMEOUT_MS=

# ============================================================
# 本项目配置
# ============================================================

# 逐章总结 / 全书评测用的模型（不填则跟 ANTHROPIC_MODEL）
# LLM_SUMMARY_MODEL=MiniMax-M3.1-Flash
# LLM_REVIEW_MODEL=MiniMax-M3.1-Flash

# 思考深度：low | medium | high | xhigh | max
LLM_EFFORT=medium

# 结构化输出模式：
#   native —— messages.parse（服务端强制 schema，官方 Anthropic 支持）
#   prompt —— 提示词要求 JSON + 本地 pydantic 校验 + 修复重试
#   auto  —— 先试 native，失败自动降级（默认）
# ⚠️ 实测：MiniMax 的兼容端点**接受** output_config.format 但不强制，
#    返回散文导致校验失败 → 必须能降级
LLM_STRUCTURED_OUTPUT=auto

# 离线模式：不调 API，用占位内容跑通全流程（验证管道用）
# MOCK=1

# ============================================================
# 采集
# ============================================================
# BOOK_URL=https://weread.qq.com/web/reader/xxxx
